# Ivee's settings. The installer copies this to /opt/ivee/config/ivee.env
# (~/.ivee/config/ivee.env on a Mac), and the config page edits that copy:
# http://<server-ip>:8088. Empty or missing values use the defaults shown.

# Required. https://console.groq.com/keys (free). Groq turns the child's speech
# into text (Whisper) and, unless a local model answers, writes the replies.
GROQ_API_KEY=gsk_replace_me

# Required. This server's address on your network; the device connects to it.
# Give the server a DHCP reservation on your router so it never changes.
SERVER_LAN_IP=192.168.1.50

# Hours from UTC, for "what day is it?" (e.g. -7, 1, 5.5).
TIMEZONE_OFFSET=0

# Ports. The device stores http://<SERVER_LAN_IP>:<SERVER_HTTP_PORT>/xiaozhi/ota/,
# so changing SERVER_HTTP_PORT means entering that URL on the device again. The
# WebSocket port is handed out by that URL and can change freely. On a Mac, 5000
# is taken by AirPlay Receiver, so use another TTS_PORT.
SERVER_WS_PORT=8000
SERVER_HTTP_PORT=8003
TTS_PORT=5000

# Replies. Any Groq chat model with tool calling; each model has its own free
# daily quota, so the fallback answers when the main one is rate-limited.
GROQ_LLM_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b

# Optional extra provider: any OpenAI-compatible API (NVIDIA NIM, OpenRouter, a
# paid provider...), tried before Groq; Groq answers when it can't. Needs the
# base URL (ending in /v1) and a model with tool calling; empty = off. Some free
# tiers allow testing and evaluation only: check the provider's terms.
EXTRA_LLM_BASE_URL=
EXTRA_LLM_MODEL=
EXTRA_LLM_API_KEY=

# Optional local model (Ollama), tried first while reachable; Groq answers when
# it isn't. Ollama on another computer must listen on the LAN (OLLAMA_HOST=0.0.0.0).
# OLLAMA_MODEL=none to always use Groq. LLM_MODULE=OllamaLLM uses only Ollama
# for replies (Groq still does speech-to-text).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=none
LLM_MODULE=GroqLLM

# The character's voice: Kokoro. Voices: af_heart, af_bella, af_sky, am_puck, ...
# TTS_PITCH 1 = natural, 1.12 = +2 semitones (playful and still clear).
# TTS_SPEED 0.9 is slow enough for a small child. TTS_BOOST is a loudness
# compressor (1 = off). TTS_HIGHPASS / TTS_PRESENCE are small-speaker EQ: cut
# bass the speaker can't play (Hz) and lift consonants at 3 kHz (dB); 0 = off.
TTS_VOICE=af_heart
TTS_SPEED=0.9
TTS_PITCH=1.12
TTS_BOOST=2.0
TTS_HIGHPASS=300
TTS_PRESENCE=5

# Pinned upstream server (bump deliberately, then re-run the installer).
IVEE_SERVER_REPO=https://github.com/xinnan-tech/xiaozhi-esp32-server.git
IVEE_SERVER_REF=aef973e6b9e41828d42f425e28d961ff5028fb33

# Optional: server/scripts/backup.sh copies settings and logs here nightly
# (a mounted NAS share, or any rsync target).
BACKUP_TARGET=
