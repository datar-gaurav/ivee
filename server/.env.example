# Copy to server/.env and fill in. server/.env is gitignored.

# LAN IP of the machine running the server (the HP Stream Mini). Give it a
# DHCP reservation on your router so this never changes.
SERVER_LAN_IP=192.168.1.50

# Ports (defaults shown). On a Mac, 5000 is taken by AirPlay Receiver, so
# run-mac.sh needs a different TTS_PORT. The firmware has the OTA URL compiled
# in, so changing SERVER_HTTP_PORT means rebuilding the firmware; the WebSocket
# port is handed out by OTA and can change freely.
SERVER_WS_PORT=8000
SERVER_HTTP_PORT=8003
TTS_PORT=5000

# https://console.groq.com/keys
GROQ_API_KEY=gsk_replace_me
# Any Groq chat model that supports tool calling.
GROQ_LLM_MODEL=openai/gpt-oss-20b

# Which LLM block the server uses: GroqLLM (default) or MacOllamaLLM.
LLM_MODULE=GroqLLM

# Optional fallback brain on the MacBook (only works while it is awake and
# Ollama listens on the LAN: OLLAMA_HOST=0.0.0.0).
OLLAMA_BASE_URL=http://192.168.1.20:11434
OLLAMA_MODEL=qwen2.5:3b

# Piper voice (https://huggingface.co/rhasspy/piper-voices). Downloaded by the installer.
PIPER_VOICE=en_US-amy-medium

# Pinned upstream versions (bump deliberately, then re-run the installer).
XIAOZHI_SERVER_REPO=https://github.com/xinnan-tech/xiaozhi-esp32-server.git
XIAOZHI_SERVER_REF=aef973e6b9e41828d42f425e28d961ff5028fb33

# Where the NAS backup lands (a mounted share or an rsync target).
NAS_BACKUP_TARGET=/mnt/nas/sparky-backups
