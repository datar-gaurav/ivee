# Copy to server/.env and fill in. server/.env is gitignored.

# LAN IP of the machine running the server (the HP Stream Mini). Give it a
# DHCP reservation on your router so this never changes.
SERVER_LAN_IP=192.168.1.50

# Ports (defaults shown). On a Mac, 5000 is taken by AirPlay Receiver, so
# run-mac.sh needs a different TTS_PORT. The firmware has the OTA URL compiled
# in, so changing SERVER_HTTP_PORT means rebuilding the firmware; the WebSocket
# port is handed out by OTA and can change freely.
SERVER_WS_PORT=8000
SERVER_HTTP_PORT=8003
TTS_PORT=5000

# https://console.groq.com/keys
GROQ_API_KEY=gsk_replace_me
# Any Groq chat model that supports tool calling.
GROQ_LLM_MODEL=openai/gpt-oss-20b
# Used when GROQ_LLM_MODEL hits a rate limit (each model has its own free quota).
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b

# Which LLM block the server uses: GroqLLM (default) or MacOllamaLLM.
LLM_MODULE=GroqLLM

# Local brain on the MacBook, tried first while it's reachable; Groq answers
# when it isn't. Server on the Mac: http://127.0.0.1:11434. Server on the HP:
# the Mac's LAN IP, and Ollama must listen on the LAN (OLLAMA_HOST=0.0.0.0).
# OLLAMA_MODEL=none to always use Groq.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M

# Speel's voice: Kokoro (server/tts/speel_tts.py). Voices: af_heart, af_bella,
# af_sky, am_puck, ... TTS_PITCH 1 = natural; 1.12 = +2 semitones (playful and
# still clear); 1.26 = +4 semitones (too squeaky to understand on this speaker).
# TTS_SPEED 0.9 is slow enough for a 4-year-old. TTS_BOOST is a loudness
# compressor (1 = off). TTS_HIGHPASS / TTS_PRESENCE are small-speaker EQ: cut
# bass the speaker can't play (Hz) and lift consonants at 3 kHz (dB); 0 = off.
TTS_VOICE=af_heart
TTS_SPEED=0.9
TTS_PITCH=1.12
TTS_BOOST=2.0
TTS_HIGHPASS=300
TTS_PRESENCE=5

# Pinned upstream versions (bump deliberately, then re-run the installer).
XIAOZHI_SERVER_REPO=https://github.com/xinnan-tech/xiaozhi-esp32-server.git
XIAOZHI_SERVER_REF=aef973e6b9e41828d42f425e28d961ff5028fb33

# Where the NAS backup lands (a mounted share or an rsync target).
NAS_BACKUP_TARGET=/mnt/nas/sparky-backups
