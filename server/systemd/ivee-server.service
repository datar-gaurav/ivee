[Unit]
Description=Ivee voice server (upstream xiaozhi-esp32-server, checked out as ivee-esp32-server)
# Not started until the config page (or the installer) has rendered a config.
ConditionPathExists=@APP_DIR@/data/.config.yaml
After=network-online.target ivee-tts.service
Wants=network-online.target ivee-tts.service

[Service]
Type=simple
User=@USER@
WorkingDirectory=@APP_DIR@
ExecStart=@PREFIX@/venv-server/bin/python app.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
# Keep a runaway process from taking the whole 2 GB box down.
MemoryMax=1400M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
